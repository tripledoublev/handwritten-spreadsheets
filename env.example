# Ollama Configuration
# Copy this file to .env and modify the values as needed

# Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Basic Auth Configuration (optional)
# Leave empty if no authentication is required
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# Model to use for OCR processing (default: qwen3-vl:30b)
OLLAMA_MODEL=qwen3-vl:30b

# Example configurations:

# For external Ollama server with basic auth:
# OLLAMA_HOST=https://your-ollama-server.com
# OLLAMA_USERNAME=your_username
# OLLAMA_PASSWORD=your_password

# For external Ollama server with token auth:
# OLLAMA_HOST=https://your-ollama-server.com
# OLLAMA_AUTH_TOKEN=your_token_here

# Authentication Configuration
# Generate a strong secret key for session management
SECRET_KEY=

# Application password to gate access
APP_PASSWORD=
